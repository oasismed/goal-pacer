{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": { "includes": ["web/**/*.js", "web/**/*.css"] },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "useTemplate": "off", "noDescendingSpecificity": "off" },
      "complexity": { "useArrowFunction": "off", "useOptionalChain": "off", "noImportantStyles": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["web/parear.js"],
      "linter": { "rules": { "suspicious": { "noRedundantUseStrict": "off" } } }
    }
  ]
}
